
direction: right

Observations: {
  shape: sql_table
  style: {fill: "#f8cecc"}
  source_id: "value | geometry"
  "src_1   ": "10000 | POLY(..)"
  "src_2   ": "20000 | POLY(..)"
  "src_3   ": "30000 | POLY(..)"
}

Sidecar: {
  shape: sql_table
  style: {fill: "#dae8fc"}
  index: "source id | healpix id"
  "1": "src_1 | h_pix_A"
  "3": "src_2 | h_pix_A"
  "4": "src_3 | h_pix_B"
}

Healpix_Target_Grid: {
  shape: sql_table
  style: {fill: "#d5e8d4"}
  index: "healpix id"
  "1": "h_pix_A"
  "2": "h_pix_B"
}

Observations <-> Sidecar: "healpyxel_sidecar\n(Assign: strict/fuzzy)" {style: {stroke-width: 2}}
Sidecar <-> Healpix_Target_Grid: nside=32
